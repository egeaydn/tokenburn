{
  "name": "tokenburn-ai",
  "version": "0.1.0",
  "description": "Local-only spend tracker for AI coding tools (Claude Code, Codex CLI). See what each repo costs you.",
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "license": "MIT",
  "bin": {
    "tokenburn": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "demo": "tsx scripts/demo.ts",
    "update-pricing": "node scripts/update-pricing.mjs"
  },
  "keywords": [
    "claude-code",
    "codex",
    "codex-cli",
    "ai-coding",
    "token",
    "cost",
    "usage",
    "spend",
    "tracker",
    "cli",
    "llm"
  ],
  "dependencies": {
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "fzstd": "^0.1.1",
    "picocolors": "^1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "author": "Ege Aydın",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egeaydn/tokenburn.git"
  },
  "homepage": "https://github.com/egeaydn/tokenburn#readme",
  "bugs": {
    "url": "https://github.com/egeaydn/tokenburn/issues"
  }
}
